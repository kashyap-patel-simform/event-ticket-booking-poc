NODE_ENV=development
PORT=3000
# Pooled connection (Neon) — used by the running app
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/dbname?sslmode=require
# Direct/unpooled connection (same host, without "-pooler") — required for `prisma migrate`
DIRECT_URL=postgresql://user:password@ep-example.region.aws.neon.tech/dbname?sslmode=require
# Must be the real deployed client URL in production (used for CORS)
CLIENT_ORIGIN=http://localhost:5173
# Signs/verifies access tokens (HS256) — generate a long random value, e.g. `openssl rand -hex 32`
JWT_SECRET=
# Stripe test-mode secret API key (Dashboard → Developers → API keys)
STRIPE_SECRET_KEY=sk_test_...
# Signing secret for verifying webhook payloads — from `stripe listen` (local dev) or the
# Dashboard's webhook endpoint config (deployed)
STRIPE_WEBHOOK_SECRET=whsec_...
