{
  "name": "event-booking-server",
  "version": "1.0.0",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "type": "module",
  "main": "dist/server.js",
  "dependencies": {
    "@prisma/client": "^6.12.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "winston": "^3.19.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.5.1",
    "dotenv": "^17.4.2",
    "oxlint": "^1.83.0",
    "prettier": "^3.9.6",
    "prisma": "^6.12.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
